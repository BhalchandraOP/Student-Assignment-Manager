# Copy this file to .env to override the local development defaults.
MYSQL_DATABASE=student_assignment_tracker
MYSQL_USER=tracker_app
MYSQL_PASSWORD=tracker_dev_password
MYSQL_ROOT_PASSWORD=tracker_root_dev_password
MYSQL_PORT=3307
MYSQL_TIMEZONE=Asia/Kolkata

# Spring Boot authentication overrides (set in the shell or deployment environment).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=PT8H
DEMO_USER_ENABLED=true
DEMO_USER_EMAIL=student@example.com
DEMO_USER_PASSWORD=Student@123
DEMO_USER_FULL_NAME=Demo Student
